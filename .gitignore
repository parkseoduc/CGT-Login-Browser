# Node modules
node_modules/

# Chromium user data & runtime caches
data/profiles/*/chrome/
data/profiles/*/*
!data/profiles/.gitkeep
data/antidetect.db-wal
data/antidetect.db-shm

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch & temp files
scratch/
temp_*
temp/

# Portable Chromium binaries
bin/chromium/*
!bin/chromium/.gitkeep
bin/node/*
!bin/node/.gitkeep
bin/temp_kernel.zip
data/tmp_backups/
